# Root-level configuration reference
# Note: Place actual environment variables inside backend/.env during local development

# Application Configuration
APP_NAME="Darkrai"
APP_ENV=development  # development, staging, production
DEBUG=true

# Database Settings (PostgreSQL with asyncpg driver)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/darkrai"

# Security (JWT signing key & Fernet 32-byte Base64 encryption key)
SECRET_KEY="change_me_to_a_secure_random_string"
ENCRYPTION_KEY="change_me_to_32_urlsafe_base64_encoded_bytes="

# GitHub Integration
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret"
WEBHOOK_BASE_URL="http://localhost:8000"

# CORS Settings (JSON array string)
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'
