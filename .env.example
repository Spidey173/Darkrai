# Application Configuration
APP_NAME="Darkrai"
APP_ENV=development  # development, test, staging, production
DEBUG=true

# Database Settings
# Supports postgresql+asyncpg:// or sqlite+aiosqlite:/// (defaults to sqlite+aiosqlite:///./darkrai.db for local dev)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/darkrai"

# Security (Required in production; automatic safe fallbacks enabled in development)
# Generate SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
# Generate ENCRYPTION_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=""

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret"
WEBHOOK_BASE_URL="http://localhost:8000"

# Routing and Frontend Settings
FRONTEND_URL="http://localhost:3000"
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'

# Processing & Queue Architecture
# Set EXECUTE_INLINE=true for serverless (Vercel) functions where background workers cannot persist.
# Set EXECUTE_INLINE=false (default) for durable worker containers with Redis.
EXECUTE_INLINE=false
REDIS_URL="redis://localhost:6379/0"
USE_REDIS_QUEUE=true
MAX_EVENT_RETRIES=3

# Optional LLM API Keys for AI-powered pull request reviews
GEMINI_API_KEY=""
OPENAI_API_KEY=""
